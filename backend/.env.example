# --- LLM ---
# Google Gemini has a genuine ongoing free tier (no credit card required).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Web research tool ---
# Free tier: 1,000 credits/month, no credit card required. Get a key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- Live market data (optional but recommended) ---
# Free tier: 60 calls/min, no credit card required. Get a key at https://finnhub.io/register
# If left blank, the agent skips live stock data and just notes the company as private/unresolved.
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Server ---
PORT=8787
# Comma-separated list of origins allowed to call this API (your deployed frontend URL, plus localhost for dev)
CORS_ORIGIN=http://localhost:5173
